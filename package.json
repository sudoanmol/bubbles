{
  "name": "bubbles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "deploy": "pnpm -C backend db:migrate:remote && pnpm -C backend deploy && pnpm -C frontend deploy",
    "typecheck": "pnpm -r run typecheck && tsc -p tests",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "prepare": "husky",
    "chaos": "node tests/chaos.ts",
    "test": "node tests/rules.ts && node tests/store.ts && pnpm -C backend test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^6.0.3",
    "ulid": "^3.0.2"
  }
}
