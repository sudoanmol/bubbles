# Single env file for every workspace package. Copy to .env.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (the frontend proxies /api to the backend in dev)
BETTER_AUTH_URL=http://localhost:3100

# Google Cloud console → OAuth client (Web).
# Authorized redirect URI: http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
