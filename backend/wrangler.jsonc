{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bubbles-api",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "dev": { "port": 8790 },
  "d1_databases": [{ "binding": "DB", "database_name": "bubbles", "migrations_dir": "drizzle" }],
}
