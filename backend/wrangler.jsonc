{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bubbles-api",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "dev": { "port": 8790 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bubbles",
      "database_id": "36d7f246-3c6b-4121-a5d2-94aae022ea76",
      "migrations_dir": "drizzle",
    },
  ],
}
